# =====================================================================
# Avalan demo — .gitignore
# Keeps secrets, local artifacts, and build/runtime cruft out of the
# public repository. .env.example is intentionally allowed; .env is not.
# =====================================================================

# --- Secrets / local env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# --- Dependency directories ---
/backend/vendor/
/node_modules/
**/node_modules/

# --- Archives (packaging artifacts, not source) ---
*.zip
*.tar
*.tar.gz
*.rar

# --- PHP / runtime artifacts ---
*.log
.phpunit.result.cache
php_errors.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- Local override configs some editors/IDEs create ---
.env.local
