# =====================================================================
# Avalan SmartPay — DEMO environment configuration
# Copy to .env if you want to override the defaults below. Nothing here
# is a real secret; the demo reads no database and calls no external
# service (Paylov, SMS gateway, Ollama, payment webhooks — all absent).
#
# For comparison, production's full .env.example (JWT signing secret,
# MySQL credentials, Paylov API key, field-encryption key, webhook
# secret, admin API key, ...) lives at backend/avalan-smartpay/.env.example
# in the production project — none of those values or the services they
# authenticate against are part of this public demo.
# =====================================================================

APP_ENV=demo

# Header value the demo API expects on every request (see
# public/index.php + DemoAuthService::appKeyValid()). Mirrors
# production's AVALAN_APP_KEY gate concept with a public, non-secret
# placeholder value — change it if you want to run your own copy of the
# demo privately.
AVALAN_DEMO_APP_KEY=avalan-demo-app-key
